	"item": [
		{
			"name": "Is Valid ISBN13 Number",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let jsonData = xml2Json(pm.response.text());",
							"let result = jsonData[\"soap:Envelope\"][\"soap:Body\"][\"m:IsValidISBN13Response\"][\"m:IsValidISBN13Result\"];",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time is under 1500 ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(1500);",
							"});",
							"",
							"pm.test(\"Content-Type is text/xml\", function () {",
							"    pm.response.to.have.header(\"Content-Type\");",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");",
							"});",
							"",
							"pm.test(\"Server header is present\", function () {",
							"    pm.response.to.have.header(\"Server\");",
							"});",
							"",
							"pm.test(\"Content-Length header exists and > 0\", function () {",
							"    pm.response.to.have.header(\"Content-Length\");",
							"    const cl = Number(pm.response.headers.get(\"Content-Length\"));",
							"    pm.expect(cl).to.be.above(0);",
							"});",
							"",
							"pm.test(\"Response has SOAP Envelope\", function () {",
							"    pm.expect(pm.response.text()).to.include(\"<soap:Envelope\");",
							"});",
							"",
							"pm.test(\"Has IsValidISBN13Response element\", function () {",
							"    pm.expect(pm.response.text()).to.include(\"IsValidISBN13Response\");",
							"});",
							"",
							"pm.test(\"No SOAP Fault in response\", function () {",
							"    pm.expect(pm.response.text()).to.not.include(\"<soap:Fault\");",
							"});",
							"",
							"pm.test(\"IsValidISBN13Result element exists\", function () {",
							"    pm.expect(result).to.not.be.undefined;",
							"});",
							"",
							"pm.test(\"IsValidISBN13Result is true\", function () {",
							"    pm.expect(result.toString()).to.eql(\"true\");",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/xml; charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>",
					"options": {
						"raw": {
							"language": "xml"
						}
					}
				},
				"url": {
					"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
					"protocol": "http",
					"host": [
						"webservices",
						"daehosting",
						"com"
					],
					"path": [
						"services",
						"isbnservice.wso"
					]
				}
			},
			"response": []
